{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "youtube-cloudflare-browser-fetch",
  "main": "src/fetch.js",
  "compatibility_date": "2026-09-29",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "keep_vars": true,
  "browser": {
    "binding": "BROWSER"
  }
}

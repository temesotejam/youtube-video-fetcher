{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "youtube-video-fetcher-probe",
  "main": "src/index.js",
  "compatibility_date": "2026-09-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "containers": [
    {
      "class_name": "YouTubeProbeContainer",
      "image": "./Dockerfile",
      "max_instances": 1,
      "instance_type": "basic"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "YOUTUBE_PROBE",
        "class_name": "YouTubeProbeContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["YouTubeProbeContainer"]
    }
  ]
}
